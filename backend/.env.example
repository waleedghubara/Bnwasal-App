# Server
PORT=5000
NODE_ENV=development

# Database (required)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=we_deliver

# JWT — required in production (min 32 chars each)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
RESET_JWT_SECRET=change-me-reset-only-secret-at-least-32-chars

# CORS — comma-separated origins (required in production)
ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# Access token lifetime (production default in code: 24h if unset)
# JWT_EXPIRES_IN=24h

# Kashier wallet webhook HMAC (required in production)
# KASHIER_WEBHOOK_SECRET=

# Landing page API key (required in production)
# LANDING_API_KEY=

# Uploads: required in production (startup fails without it)
UPLOADS_REQUIRE_AUTH=1

# Dev only: secret header for POST /api/support/create-test-admin (disabled in production)
# DEV_BOOTSTRAP_SECRET=

# Web Push (required in production)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# WhatsApp Hypersender Configuration (required for OTP)
WHATSAPP_INSTANCE_ID=your-instance-id-here
WHATSAPP_API_TOKEN=your-bearer-token-here
WHATSAPP_BASE_URL=https://app.hypersender.com/api/whatsapp/v2
